FROM golang:1.27-alpine AS build-stage
WORKDIR /usr/src/app
COPY 1_13 .
RUN go build -o app-binary 
RUN  addgroup -g 10001 -S appgroup && adduser -u 10001 -S non-root-user -G appgroup
FROM scratch
COPY --from=build-stage /etc/passwd /etc/passwd
COPY --from=build-stage /etc/group /etc/group
WORKDIR /usr/src/app
COPY --from=build-stage /usr/src/app/app-binary /usr/src/app/app-binary
USER non-root-user
EXPOSE 8080
ENV REQUEST_ORIGIN=http://localhost:5001
CMD ["./app-binary"]
