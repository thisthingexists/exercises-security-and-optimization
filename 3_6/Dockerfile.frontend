FROM ubuntu:22.04
EXPOSE 5001
WORKDIR /usr/src/app
ENV REACT_APP_BACKEND_URL=http://localhost:8080
COPY  1_12 .
RUN apt-get update && apt-get install -y curl && curl -sL https://deb.nodesource.com/setup_16.x | bash && apt-get install -y nodejs && npm install -g serve && useradd -m non-root-user && chown -R non-root-user /usr/src/app && apt-get purge -y --auto-remove curl && rm -rf /var/lib/apt/lists/* && npm install && npm run build && rm -rf src public node_modules &&  npm cache clean --force
USER non-root-user
CMD ["serve", "-s", "-l", "5001", "build"]

